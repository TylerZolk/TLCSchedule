generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  pin        Int      @id
  name       String
  role       String
  restaurant String?
  position   String?
  username   String?  @unique
  password   String?
  wage       Float?
  isMinor    Boolean  @default(false)
  createdAt  DateTime @default(now())

  availability     Availability[]
  shifts           Shift[]
  swapRequestsFrom SwapRequest[]  @relation("FromUser")
  swapRequestsTo   SwapRequest[]  @relation("ToUser")
  sessions         Session[]
}

model Availability {
  id          Int     @id @default(autoincrement())
  pin         Int
  day         String
  unavailable Boolean @default(true)
  open        Boolean @default(false)
  start       Float   @default(9)
  end         Float   @default(17)

  user User @relation(fields: [pin], references: [pin], onDelete: Cascade)

  @@unique([pin, day])
}

model Shift {
  id        Int     @id @default(autoincrement())
  pin       Int
  weekStart String  @default("")
  day       String
  start     Float
  end       Float
  position  String?

  user User @relation(fields: [pin], references: [pin], onDelete: Cascade)
}

model ShiftSlot {
  id         String @id
  restaurant String
  day        String
  position   String
  start      Float
  end        Float
  count      Int    @default(1)
}

model SwapRequest {
  id        String   @id
  fromPin   Int
  fromDay   String
  toPin     Int
  toDay     String
  weekStart String   @default("")
  status    String   @default("pending")
  createdAt DateTime @default(now())

  fromUser User @relation("FromUser", fields: [fromPin], references: [pin], onDelete: Cascade)
  toUser   User @relation("ToUser",   fields: [toPin],   references: [pin], onDelete: Cascade)
}

// Snapshot of a restaurant's schedule for one week, as employees see it
model PublishedSchedule {
  restaurant  String
  weekStart   String
  publishedAt DateTime @default(now())
  snapshot    Json

  @@id([restaurant, weekStart])
}

model Session {
  token     String   @id
  pin       Int
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [pin], references: [pin], onDelete: Cascade)
}

model ShiftPreset {
  id         Int     @id @default(autoincrement())
  restaurant String
  name       String
  start      Float
  end        Float
  position   String?
}
